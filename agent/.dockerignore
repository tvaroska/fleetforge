# The build context for agent/Dockerfile.
#
# `build/` and `sdkconfig` must never enter it: idf.py generates `sdkconfig` on the
# first build and THAT FILE WINS over sdkconfig.defaults from then on, so a stale copy
# leaking in from the host would silently ship a bootloader whose rollback option no
# longer matches agent/sdkconfig.defaults. The container starts from no sdkconfig at all.
build/
sdkconfig
sdkconfig.old

# The finished bundles are output, not input.
dist/

# PROJECT_VER comes from version.txt precisely because .git is not here.
.git

# PlatformIO build output of the Arduino library example (R3-fw-3): hundreds of MB, and
# not an input to the IDF build.
**/.pio

# A host `idf.py build` of the ESP-IDF example (R3-fw-4): output, never an input, and its
# `sdkconfig` would be read as the example's own if it ever reached a build.
components/fleetforge/examples/*/build
components/fleetforge/examples/*/sdkconfig
components/fleetforge/examples/*/sdkconfig.old
components/fleetforge/examples/*/dependencies.lock
components/fleetforge/examples/*/managed_components
