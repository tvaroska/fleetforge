# Fleetforge agent — common sdkconfig defaults. **CRITICAL.**
#
# CRITICAL.md: "Partition table, `sdkconfig` bootloader options, eFuse burns (agent
# firmware) — flash-time immutables, not changeable by OTA. Wrong at R0 = physical
# recall of the fleet." Every line below implements a named decision in
# design/architecture.md -> Flash-time immutables. Per-target files carry deltas only;
# every safety option lives HERE so there is one place to read the posture from.
#
# What is deliberately ABSENT matters as much as what is present — see the bottom of
# this file. tests/test_agent_partitions.py asserts both halves.

# The A/B layout is ours, not one of the presets. partitions.csv is the contract.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# 4 MB is the declared minimum (design/architecture.md: "Budget 4 MB flash minimum").
# A larger chip still boots a 4 MB-configured image; a smaller one cannot hold ab-4m-v1.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# R2's auto-rollback. A BOOTLOADER build-time option: it cannot be turned on later by
# OTA, which is why it is decided at R0 (design/architecture.md, item 2). Safe to enable
# before R0-fw-1 exists: a serially-flashed app never enters PENDING_VERIFY (otadata is
# invalid on a fresh chip, so the bootloader boots ota_0 UNDEFINED and arms no timer).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# The app version is PROJECT_VER, read from version.txt by CMakeLists.txt, so it is the
# same string the announce payload reports as `agent_version`.
CONFIG_APP_PROJECT_VER_FROM_CONFIG=n

# ── Deliberately NOT enabled (design/architecture.md -> eFuse, one-way burns) ────────
# CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK  — burns a monotonic counter that blocks R2's
#                                        rollback-to-previous. Off in v1.
# CONFIG_SECURE_BOOT / _V2_ENABLED     — burns a key digest to eFuse; new-devices-only,
#                                        post-v1. R5 ships app-level signature
#                                        verification instead. Not interchangeable.
# CONFIG_SECURE_FLASH_ENC_ENABLED      — flash encryption off in v1; spec/prd.md ->
#                                        Security & data posture already promises this.

# ── Added by R0-fw-1 (the connect-only agent) ───────────────────────────────────────
# The Mozilla root CA bundle, compiled in. Both of the agent's outbound channels are
# TLS in production — HTTPS to the API and mqtts:// to the broker — and both terminate
# at Traefik with a Let's Encrypt certificate (DECISIONS.md, R0-infra-3), so there is
# no private CA to pin at v1. Without this, esp_crt_bundle_attach does not link and
# every handshake fails at the point where it is hardest to read: inside mbedTLS.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# Check certificate VALIDITY DATES. IDF leaves this off by default, and off it is
# not a nuance: mbedTLS then accepts an expired certificate, and a revoked-then-expired
# server key stays a working MITM against the whole fleet forever. It is also what makes
# `spec/device-protocol.md` -> *Clock — SNTP before TLS* true rather than aspirational —
# with the default config a board at epoch 0 completes the handshake happily, and the one
# protocol rule with its own section is unenforced. Verified both ways in QEMU (R0-fw-1
# AC5): `--no-ntp` must fail the handshake, and a synced clock must complete it.
#
# The cost is real and accepted: a board whose SNTP never answers cannot reach an https://
# or mqtts:// endpoint. ff_time leaves the SNTP client running after a timeout, so the
# clock still arrives late while the enroll ladder backs off.
CONFIG_MBEDTLS_HAVE_TIME_DATE=y

# ── Added by S0-fw-3 (boards that brown out during RF calibration) ──────────────────
# When the previous reset was a brownout, bring the PHY up at its lowest TX power for
# this boot. IDF defaults this OFF.
#
# The failure it breaks is a loop, not a one-off. A board with no cached RF calibration
# in NVS runs the FULL calibration on every boot (`phy_init: failed to load RF
# calibration data (0x1102), falling back to full calibration`), which is the largest
# current draw anywhere in startup. On a rail that cannot hold 3.3 V through it, the
# brownout detector fires mid-calibration — so the result is never written back, and the
# next boot does exactly the same thing. The board cannot bootstrap out of it: the
# calibration is only cached once a boot survives it.
#
# With this on, the retry after a brownout draws materially less, which is often enough
# to get through once. One survived boot caches the calibration, and every boot after it
# skips the expensive path and runs at normal power. Costs nothing on a healthy board:
# `esp_reset_reason() == ESP_RST_BROWNOUT` is false there and the option is inert.
#
# Fleet-wide TX power is deliberately NOT reduced (CONFIG_ESP_PHY_MAX_WIFI_TX_POWER stays
# at 20 dBm): that would trade range on every board in the fleet for a fault only some
# have. This is the targeted version of the same idea.
#
# Unlike everything above it, this one is NOT a flash-time immutable — it ships in the
# app image and an OTA can add or remove it. It lives here because this is the one file
# the agent's power posture is read from, not because it is unrecoverable.
CONFIG_ESP_PHY_REDUCE_TX_POWER=y

# ── Also S0-fw-3, after the option above was measured and did NOT clear the fault ────
# 80 MHz, not IDF's default 160.
#
# Two reasons, and the second is why it is here rather than in a performance note.
#
# 1. This agent is I/O-bound and always will be. Its whole duty cycle is: wait for DHCP,
#    two TLS handshakes, then one small JSON every `hb_s` seconds. 160 MHz buys nothing
#    measurable and costs roughly 20-30 mA continuously.
# 2. `esp_clk_init()` applies this BEFORE app_main, so it is already in effect during PHY
#    calibration — the window S0-fw-3 is about. The v0.3.3 attempt reduced TX power during
#    that window and the board died in exactly the same place, which established that TX
#    power is not what dominates the draw. It did not establish that nothing else does.
#    The CPU is running flat out alongside the calibration, and 20-30 mA is a plausible
#    margin on a rail that is already collapsing. Unlike REDUCE_TX_POWER this applies on
#    EVERY boot, including the first one after a clean reset, so it does not need the
#    fault to have already happened in order to help.
#
# The cost, accepted: TLS handshakes take roughly twice as long (hardware MPI/SHA absorb
# most of it), and R2's OTA download will be slower. Neither is on a deadline. If R2
# measures the download as too slow, the answer is `esp_pm_configure` to raise the clock
# for the transfer, not a return to 160 MHz for the life of the board.
#
# NOT a flash-time immutable — app image, OTA can change it. Here for the same reason as
# the option above: this file is where the power posture is read from.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y

# ── Size: -Os, not IDF's default -Og ────────────────────────────────────────────────
# The connect-only agent builds to ~1.08 MB of a 1,966,080-byte OTA slot — 55% full
# before R2 adds OTA and R5 adds signature verification. IDF defaults new projects to
# `COMPILER_OPTIMIZATION_DEBUG` (-Og), which is the right default for a project being
# stepped through in a debugger and the wrong one for an image that has to fit a slot it
# also has to be able to download a replacement into.
#
# Assertions stay ON (CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE is independent of
# this) — they are diagnostic output, and this agent's whole thesis is that faults name
# themselves. The one real cost is that -Os makes panic backtraces less faithful, which
# slightly degrades what the serial console (S0-fe-1) has to classify. Taken knowingly:
# a board that cannot OTA has no backtrace worth reading either.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# app_main runs the whole boot sequence — cJSON payload building, an HTTPS request with
# a TLS handshake on this stack, NVS. The 3584-byte default overflows during the enroll
# handshake, and a stack overflow on a board is a reboot loop with a backtrace nobody is
# there to read.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
