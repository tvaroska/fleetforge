# Keep the build context small — and keep secrets out of images.
.git
.gitignore
.github

# Never bake an env file into a layer.
.env
.env.*
!.env.example

# Host virtualenv and caches; the image builds its own .venv.
.venv
venv
__pycache__
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
htmlcov
.coverage

# The frontend has its own build context (./frontend).
frontend/node_modules
frontend/dist

# Docs and planning never affect the image.
docs
spec
design
.claude
*.md
!README.md

# The agent firmware (R0-infra-2). `agent/dist` is the ONLY part that belongs in the
# app image — the Dockerfile copies it to /app/agent. The ESP-IDF project itself is
# built by agent/Dockerfile, in a different context, and would otherwise invalidate
# the app image's layers on every firmware edit.
agent/build
agent/main
agent/tools
agent/CMakeLists.txt
agent/Dockerfile
agent/partitions.csv
agent/sdkconfig*
agent/version.txt
