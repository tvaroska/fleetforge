# Keep the build context small — and keep secrets out of images.
.git
.gitignore
.github

# Never bake an env file into a layer.
.env
.env.*
!.env.example

# Host virtualenv and caches; the image builds its own .venv.
.venv
venv
__pycache__
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
htmlcov
.coverage

# The frontend has its own build context (./frontend).
frontend/node_modules
frontend/dist

# Docs and planning never affect the image.
docs
spec
design
.claude
*.md
!README.md

# The agent firmware. NONE of it belongs in the app image since S0-infra-6: the built
# bundles are artifacts served out of the object store (`just agent-publish`), and the
# ESP-IDF project itself is built by agent/Dockerfile in a different context. Excluding
# the whole directory is also what keeps a firmware edit from invalidating the app
# image's layers. `agent/dist` is listed explicitly as well as under `agent/` so that
# re-adding a narrower rule cannot quietly let the 1.2 MB-per-target bundles back in.
agent/
agent/dist
