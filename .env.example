# Copy to .env for local development. `.env` is gitignored and must never hold a real
# credential — the production environment lives in `services/prod/.env` (see root
# CLAUDE.md; changing it requires asking first).
#
# Port 5433, not 5432: 5432 on this host belongs to an unrelated container.
DATABASE_URL=postgresql+asyncpg://fleetforge:fleetforge@localhost:5433/fleetforge

# Optional. Defaults to DATABASE_URL with the database name swapped for
# `fleetforge_test`; the test suite creates and drops that database itself.
# TEST_DATABASE_URL=postgresql+asyncpg://fleetforge:fleetforge@localhost:5433/fleetforge_test

# ---------------------------------------------------------------------------
# Standalone Compose stack (`just up`). Read by docker compose for ${VAR}
# interpolation in docker-compose.yml — nothing here is injected into a
# container as an environment variable.
#
# WARNING: DATABASE_URL above is the *host* URL (localhost:5433), used by
# alembic, pytest and `just migrate`. Containers get their own DATABASE_URL
# (postgres:5432) set directly in docker-compose.yml. Never add
# `env_file: .env` to the api or ingestor service — it would inject the host
# URL into the container, and pydantic-settings gives real environment
# variables precedence over .env values, so the API would quietly try to reach
# localhost:5433 inside its own network namespace.
#
# Host ports are all overridable: 80/443 are deliberately not published (this
# is a shared dev machine) and 5432 belongs to an unrelated container.
# ---------------------------------------------------------------------------
FF_DOMAIN=localhost
FF_HTTP_PORT=8080
FF_MQTT_PORT=8883
FF_MINIO_PORT=9000
FF_MINIO_CONSOLE_PORT=9001
FF_TRAEFIK_DASHBOARD_PORT=8081

# Dev-only and obviously fake. A real credential never lives in a tracked file;
# production values live in services/prod/.env.
MINIO_ROOT_USER=fleetforge
MINIO_ROOT_PASSWORD=fleetforge-dev-only
S3_BUCKET=fleetforge

# ---------------------------------------------------------------------------
# Object store (R0-be-6). These are the HOST values, read by `just storage-check`
# and the object-store tests — the same warning as DATABASE_URL above: the `api`
# service sets its OWN S3_ENDPOINT_URL (http://minio:9000) in docker-compose.yml,
# and pydantic-settings gives real environment variables precedence over .env.
#
# S3_PUBLIC_ENDPOINT_URL is the endpoint a DEVICE must be able to reach. A
# presigned URL signs the Host header, so a URL generated against the
# container-internal endpoint cannot be rewritten afterwards — the signature stops
# matching. On the host the two are the same; inside the compose network they are
# not, which is why the api service overrides it.
# ---------------------------------------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=fleetforge
S3_SECRET_KEY=fleetforge-dev-only

# GCS (production). Commented on purpose — setting BOTH S3_* and GCS_* is refused
# rather than resolved by precedence. The service-account key file is NEVER
# committed (`secrets/` is gitignored) and only its PATH ever appears here; mint it,
# scope it to the fleetforge/ prefix with an IAM condition, and rotate it per
# docs/runbooks/artifact-storage.md. gs://btvaroska is SHARED with this estate's
# secrets/ backups and the boris podcast audio, so GCS_PREFIX is a security boundary.
# GCS_BUCKET=btvaroska
# GCS_PREFIX=fleetforge/
# GCS_CREDENTIALS_FILE=secrets/fleetforge-artifacts.json

# ---------------------------------------------------------------------------
# Admin login (R0-be-1). This is the argon2id HASH, never a password — the API
# has no way to recover the plaintext from it. The dev value below hashes the
# obviously-fake password `fleetforge-dev-only`; production sets its own in
# services/prod/.env (confirm before changing that file).
#
# THE SINGLE QUOTES ARE LOAD-BEARING. A PHC string is full of `$`, and docker
# compose interpolates `$argon2id`, `$v`, `$m` as variables — unquoted, the
# container receives "=19=19456" and login can never succeed. python-dotenv
# strips the surrounding quotes, so this one line serves both the host process
# and compose interpolation. Verify with:
#     docker compose config | grep -i ADMIN_PASSWORD_HASH
#
# Mint a new one:  just admin-password
# ---------------------------------------------------------------------------
ADMIN_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$nn3q2PV95rIMy81e5c/e0Q$1+ejYFyS8TYVs0nMfOtKzsXFtC9mzfY5EE7NS0rMeT8'

# V2 self-hosting will need this. TLS is deliberately not solved in v1
# (spec/prd.md -> Deployment model); http://localhost is already a secure
# context, so Web Serial and `Secure` cookies work without it.
# FF_ACME_EMAIL=

# ---------------------------------------------------------------------------
# Broker credentials (R0-sec-1). The broker authenticates everybody from R0-sec-1
# on — `mosquitto/conf.d/20-dynsec.conf` sets `allow_anonymous false`.
#
# TWO credentials, two privileges, rotated separately:
#   * MQTT_DYNSEC_*   — the dynamic-security ADMIN. Broker-root: it creates the
#     per-device clients at `POST /v1/enroll` (`broker/dynsec.py`) and it is what
#     the mosquitto healthcheck authenticates as. Also used by `just broker-check`
#     and, when no explicit credential is given, by `just mqtt-pub`/`mqtt-sub`.
#   * MQTT_INGESTOR_* — the ingestor's own client. Read-only, `ff/v1/d/+/up/#`
#     only, no $SYS, no write.
# A DEVICE's credential is neither of these: username = device_id, password =
# whatever `/v1/enroll` returned for it, and it exists only in that response body.
#
# THESE ARE DEV-ONLY, OBVIOUSLY-FAKE VALUES, same convention as
# MINIO_ROOT_PASSWORD. Production values live in services/prod/.env (R0-infra-3;
# confirm before changing that file) and must be freshly generated — never these.
#
# All four are mandatory in docker-compose.yml (`${VAR:?}`, no default): the
# bootstrap, the broker healthcheck, the api and the ingestor all need them, and a
# stack that boots half-authenticated is worse than one that refuses to start.
# With MQTT_DYNSEC_* unset the API falls back to `NullProvisioner` (tests, a bare
# `create_app()`), which provisions nothing and leaves
# `devices.broker_provisioned_at` NULL — the honest reconcile list.
#
# CHANGING MQTT_DYNSEC_PASSWORD AFTER THE STORE EXISTS does not re-key it: the
# store lives in the `fleetforge_mosquitto` volume and the bootstrap then cannot
# authenticate (it says so and exits 1). Rotate with `mosquitto_ctrl … dynsec
# setClientPassword`, or `just nuke` and re-enroll every board.
# ---------------------------------------------------------------------------
MQTT_DYNSEC_USERNAME=ff-admin
MQTT_DYNSEC_PASSWORD=dynsec-dev-only
MQTT_INGESTOR_USERNAME=ff-ingestor
MQTT_INGESTOR_PASSWORD=ingestor-dev-only

# Where a HOST process reaches the broker (`just broker-check`). Same trap as
# DATABASE_URL: the containers set their own MQTT_HOST=mosquitto / MQTT_PORT=1883
# in docker-compose.yml and pydantic-settings prefers a real environment variable
# over a .env value, so these two only ever affect host-side tooling. Mosquitto
# publishes no host port — 8883 is Traefik's `mqtt` entrypoint.
MQTT_HOST=localhost
MQTT_PORT=8883

# ---------------------------------------------------------------------------
# Prebuilt agent images (R0-infra-2). Where the API reads the bundles the browser
# flasher writes to a board — one directory per chip target, each holding a
# manifest.json plus the four flashable binaries, produced off-box by
# `just agent-build <target>` (docs/runbooks/agent-build.md).
#
# THIS IS A HOST-SIDE VALUE ONLY, and it is almost never right on the host: the
# `api` service sets its own AGENT_IMAGES_DIR=/app/agent in docker-compose.yml
# (baked into the image by `COPY agent/dist /app/agent`, bind-mounted from
# ./agent/dist in the dev override), and pydantic-settings prefers a real
# environment variable over a .env value. Same trap as DATABASE_URL above.
#
# Unset it to disable /v1/agent/* deliberately — the endpoints then answer 503
# instead of pretending. An empty or missing directory is the same 503, plus a
# startup WARNING naming the path, because the usual cause is a forgotten
# `just agent-build-all` rather than a decision.
# AGENT_IMAGES_DIR=agent/dist
