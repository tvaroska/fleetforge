# Pinned real-Chromium Playwright + Python simulator E2E runner image (T-29).
# Shared by Cloud Build (`cloudbuild.yaml`) and k3s staging (`services` S4-infra-39).
# Keep `PLAYWRIGHT_VERSION` matched to `frontend/package.json` `config.playwrightVersion`.
ARG PLAYWRIGHT_VERSION=1.62.1
FROM mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-noble

ARG PLAYWRIGHT_VERSION=1.62.1
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PLAYWRIGHT_MODULE=/opt/playwright/node_modules/playwright/index.mjs \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/sim-venv

COPY --from=ghcr.io/astral-sh/uv:0.12.24 /uv /usr/local/bin/uv

WORKDIR /opt/playwright
RUN npm init -y >/dev/null \
    && npm install --no-audit --no-fund "playwright@${PLAYWRIGHT_VERSION}"

WORKDIR /opt/fleetforge-deps
COPY pyproject.toml uv.lock ./
RUN uv sync --python 3.12 --frozen --no-dev --no-install-project

ENV FF_SIM_PYTHON=/opt/sim-venv/bin/python
WORKDIR /workspace/frontend
