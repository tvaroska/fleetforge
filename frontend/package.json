{
  "name": "fleetforge-frontend",
  "private": true,
  "version": "0.9.2",
  "license": "MIT",
  "type": "module",
  "config": {
    "playwrightVersion": "1.62.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "preview": "vite preview",
    "e2e:update": "node scripts/update-flow-e2e.mjs",
    "e2e:health": "node scripts/fleet-health-e2e.mjs",
    "e2e:log": "node scripts/device-log-e2e.mjs",
    "e2e:commands": "node scripts/commands-e2e.mjs",
    "e2e": "node scripts/update-flow-e2e.mjs && node scripts/fleet-health-e2e.mjs && node scripts/device-log-e2e.mjs && node scripts/commands-e2e.mjs"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "esptool-js": "^0.6.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/w3c-web-serial": "^1.0.8",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "tinypool": ">=2.1.2"
  }
}
